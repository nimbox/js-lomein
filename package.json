{
  "name": "@nimbox/js-lomein",
  "version": "0.0.24",
  "type": "module",
  "description": "A medly of typescript functions used everywhere.",
  "author": "Ricardo Marimon",
  "license": "MIT",
  "homepage": "https://github.com/nimbox/js-lomein#readme",
  "bugs": {
    "url": "https://github.com/nimbox/js-lomein/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbox/js-lomein.git"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist/* && npm run build:types && rollup -c",
    "build:types": "tsc -p tsconfig.types.json --emitDeclarationOnly --declaration --outDir dist/types",
    "build:watch": "rm -rf dist/* && npm run build:types && rollup -cw",
    "build:yalc": "rm -rf dist/* && npm run build:types && rollup -c && yalc publish",
    "build:watch:yalc": "rm -rf dist/* && npm run build:types && rollup -cw -p ./yalc.js",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@nimbox"
  },
  "peerDependencies": {
    "lodash": "^4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash": "^4.17.21",
    "execa": "^9.6.1",
    "rollup": "^4.62.2",
    "rollup-plugin-filesize": "^10.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
